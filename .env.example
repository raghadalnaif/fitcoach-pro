# ══════════════════════════════════════════════
#  قارن — متغيرات البيئة
#  انسخ هذا الملف باسم .env وضع مفاتيحك الحقيقية
# ══════════════════════════════════════════════

# ── Google CSE  (مجاني 100 بحث/يوم) ─────────
# الخطوات:
# 1. https://programmablesearchengine.google.com → New search engine
#    أضف: amazon.sa, noon.com, aliexpress.com, shein.com, temu.com
#    فعّل "Search the entire web" ← OFF
#    انسخ الـ Search engine ID
# 2. https://console.cloud.google.com → APIs & Services → Library
#    ابحث عن "Custom Search JSON API" وفعّله
#    ثم Credentials → Create API Key ← انسخه
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CSE_ID=your_cse_cx_id_here

# ── SerpAPI  (احتياطي — 100 بحث/شهر) ────────
# https://serpapi.com → Dashboard → API Key
SERP_API_KEY=your_serpapi_key_here

# ── ImgBB (رفع صور للبحث بالصورة) ───────────
# https://api.imgbb.com → Get API Key (مجاني)
IMGBB_API_KEY=your_imgbb_key_here

# ── Firebase Admin SDK ────────────────────────
# Firebase Console → Project Settings → Service accounts → Generate new private key
# انسخ محتوى ملف JSON وضعه هنا على سطر واحد
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"YOUR_PROJECT","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# ── Firebase Client (للواجهة الأمامية) ───────
# Firebase Console → Project Settings → General → Your apps → Web app
FIREBASE_API_KEY=AIzaSy...
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_ID=123456789
FIREBASE_APP_ID=1:123456789:web:abc123

# ── Admin Secret (لتصدير الإيميلات) ──────────
# اخترها أنت — اجعلها صعبة
ADMIN_SECRET=your_super_secret_key_here

# ── Port ──────────────────────────────────────
PORT=3000
