# كلمة سر لوحة تحكم المدرب — اختاريها قوية
ADMIN_PASSWORD=change_me_now

# سر توقيع الجلسات (نص طويل عشوائي)
JWT_SECRET=your_super_long_random_secret_here

# مسار قاعدة البيانات (SQLite)
DB_PATH=/var/www/urpass/data/urpass.db

# البورت
PORT=3000
