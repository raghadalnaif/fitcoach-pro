# ══════════════════════════════════════════════
#  UR PASS — متغيرات البيئة
# ══════════════════════════════════════════════

# ── Firebase Admin (لقاعدة البيانات) ──
# Firebase Console → Project Settings → Service accounts → Generate new private key
# انسخ محتوى ملف JSON على سطر واحد
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# ── سر الأدمن (كلمة سر لوحة تحكمك) ──
# اختاريها أنتِ - قوية
ADMIN_PASSWORD=change_me_now

# ── مفتاح JWT لتوقيع الجلسات ──
# نص عشوائي طويل (32+ حرف)
JWT_SECRET=your_super_long_random_secret_here_at_least_32_chars

# ── Port ──
PORT=3000
