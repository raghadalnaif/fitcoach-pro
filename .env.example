# ══════════════════════════════════════════════
#  UR PASS — متغيرات البيئة
# ══════════════════════════════════════════════

# كلمة سر لوحة تحكم المدرب — اختاريها قوية
ADMIN_PASSWORD=change_me_now

# سر توقيع الجلسات (نص طويل عشوائي)
JWT_SECRET=your_super_long_random_secret_here

# مسار قاعدة البيانات (SQLite)
DB_PATH=/var/www/urpass/data/urpass.db

# البورت
PORT=3000

# رابط الموقع العام (يُستخدم داخل رسالة الترحيب المرسلة عبر واتساب)
PUBLIC_URL=https://urpass.life

# ── WhatsApp Business Cloud API (اختياري — للإرسال التلقائي) ──
# بدون هذه المتغيرات، الموقع يستمر بالطريقة اليدوية (فتح واتساب بضغطة زر).
# يتطلب: حساب Meta Business موثّق + WhatsApp Business Platform + قالب رسالة معتمد.
# التوثيق الرسمي: https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=ur_pass_welcome
WHATSAPP_TEMPLATE_LANG=ar
